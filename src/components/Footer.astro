---
import { nav, site, type Lang } from '../data/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<footer class="site-footer">
  <div class="footer-grid container">
    <div class="footer-brand">
      <img src="/images/logo-boreal.png" width="250" height="78" alt="Boreal Plating" loading="lazy" />
      <p>{lang === 'pt' ? 'Processos industriais integrados com precisão, controle e rastreabilidade.' : 'Integrated industrial processes with precision, control and traceability.'}</p>
    </div>
    <div>
      <p class="footer-label">{lang === 'pt' ? 'Navegação' : 'Navigation'}</p>
      <ul>{nav[lang].slice(1).map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer-label">{lang === 'pt' ? 'Contato' : 'Contact'}</p>
      <address>{site.address}</address>
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <div>
      <p class="footer-label">{lang === 'pt' ? 'Acompanhe' : 'Follow'}</p>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </div>
  <div class="footer-bottom container"><span>© {new Date().getFullYear()} Boreal Plating</span><span>Joinville · Santa Catarina · Brasil</span></div>
</footer>
