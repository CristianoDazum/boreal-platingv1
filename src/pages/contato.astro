---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import ContactForm from '../components/ContactForm.astro'; import { site } from '../data/site';
---
<BaseLayout title="Contato | Boreal Plating" description="Fale com a Boreal Plating sobre requisitos técnicos, tratamento de superfícies, usinagem e fabricação de componentes." path="/contato/">
  <PageHero eyebrow="CONTATO" title="Vamos conversar sobre o seu projeto." description="Compartilhe os requisitos técnicos ou comerciais da sua necessidade. O time da Boreal poderá orientar os próximos passos." image="/images/recepcao-boreal.webp" imageAlt="Entrada da Boreal Plating em Joinville" />
  <section class="section"><div class="container contact-grid"><div class="reveal"><p class="eyebrow">CONTATO COMERCIAL</p><h2>Informação técnica começa com uma conversa objetiva.</h2><p>Entre em contato para avaliar processos, acabamentos, integração produtiva e requisitos de fornecimento.</p><div class="contact-list"><div class="contact-item"><span>Endereço</span><p>{site.address}</p></div><div class="contact-item"><span>Telefone</span><a href={site.phoneHref}>{site.phone}</a></div><div class="contact-item"><span>E-mail</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-item"><span>Redes</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a> · <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></div><div class="reveal"><ContactForm /></div></div></section>
  <iframe class="map-frame" title="Mapa da Boreal Plating em Joinville" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Rua%20Tuiuti%203835%20Joinville%20SC&output=embed"></iframe>
</BaseLayout>
