---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import DocumentGrid from '../components/DocumentGrid.astro'; import CTA from '../components/CTA.astro'; import { esgDocuments } from '../data/site';
---
<BaseLayout title="ESG | Boreal Plating" description="Práticas ambientais, sociais e de governança da Boreal, com acesso a políticas, certificados e relatórios." path="/esg/">
  <PageHero eyebrow="ESG" title="Responsabilidade integrada à forma de operar." description="Meio ambiente, pessoas e governança são tratados como partes do processo industrial e da relação da Boreal com seus públicos." image="/images/fachada-boreal.webp" imageAlt="Fachada da operação industrial da Boreal em Joinville" />
  <section class="section"><div class="container intro-grid reveal"><div><p class="eyebrow">COMPROMISSO</p><h2>Práticas estruturadas e informação acessível.</h2></div><div class="intro-copy"><p>A Boreal conduz suas atividades com foco na prevenção de impactos, no respeito às pessoas e na conformidade. Políticas, certificados e relatórios tornam públicos os compromissos que orientam a operação.</p></div></div></section>
  <section class="section-tight section-ice"><div class="container"><div class="pillars"><article class="pillar reveal"><b>01 · AMBIENTAL</b><h3>Gestão ambiental e energia</h3><p>Diretrizes para prevenção da poluição, uso responsável de recursos, gestão de emissões e consumo de energia renovável.</p></article><article class="pillar reveal"><b>02 · SOCIAL</b><h3>Respeito e transparência</h3><p>Compromissos com conduta ética, relações responsáveis e publicação dos relatórios de igualdade salarial.</p></article><article class="pillar reveal"><b>03 · GOVERNANÇA</b><h3>Conformidade e segurança</h3><p>Princípios de integridade, controles corporativos e evolução das práticas de segurança da informação.</p></article></div></div></section>
  <section class="section"><div class="container"><div class="heading-row reveal"><div><p class="eyebrow">DOCUMENTOS E RELATÓRIOS</p><h2>Compromissos documentados.</h2></div><p>Os arquivos abrem em nova aba e também podem ser baixados para consulta.</p></div><DocumentGrid documents={esgDocuments} /></div></section>
  <CTA />
</BaseLayout>
