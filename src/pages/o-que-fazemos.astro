---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import CTA from '../components/CTA.astro';
const processes = [['Engenharia','Estudo de viabilidade e desenvolvimento conforme os requisitos do projeto.'],['Matéria-prima','Seleção e aquisição de materiais de acordo com as especificações técnicas.'],['Usinagem','Fabricação dimensional controlada com precisão, repetibilidade e rastreabilidade.'],['Acabamento mecânico','Preparação da superfície para requisitos funcionais e visuais.'],['Plating','Tratamentos químicos e eletrolíticos com controle de parâmetros, espessura e acabamento.'],['Montagem','Integração de componentes e conferência conforme a especificação do conjunto.'],['Envio','Inspeção, documentação e expedição conforme os requisitos do cliente.']];
const finishes = ['14k Gold','24k Gold','Almond Gold','Antique Nickel','Bronze Dark Aged Antique','Champagne Gold','Chrome','Copper','Crescent Gold','Nickel','Platinum','Rose Gold','Silver','Smoked Nickel'];
---
<BaseLayout title="O Que Fazemos | Boreal Plating" description="Capacidades em tratamento de superfícies, plating, usinagem, injeção, fabricação, montagem e acabamento industrial." path="/o-que-fazemos/">
  <PageHero eyebrow="O QUE FAZEMOS" title="Capacidade industrial integrada em cada etapa." description="Da engenharia ao envio, a Boreal combina fabricação e acabamento com controle de processo, rastreabilidade e atenção aos requisitos técnicos." image="/images/processo-plating.webp" imageAlt="Peças metálicas produzidas e tratadas pela Boreal" />
  <section class="section"><div class="container"><div class="heading-row reveal"><div><p class="eyebrow">FLUXO DE FORNECIMENTO</p><h2>Um processo conectado do início ao fim.</h2></div><p>A integração das etapas reduz interfaces, mantém os critérios técnicos visíveis e apoia a consistência do resultado.</p></div><div class="process-list">{processes.map(([title, description]) => <article class="process-item reveal"><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container finish-grid"><div class="media-frame reveal"><img src="/images/amostras-plating.webp" alt="Mostruário real de cores e acabamentos de plating da Boreal" loading="lazy" /></div><div class="reveal"><p class="eyebrow light">PLATING</p><h2>Variedade de cores e acabamentos.</h2><p>Acabamentos decorativos em versões polida, escovada ou acetinada. Outras cores e tonalidades podem ser desenvolvidas conforme as especificações do projeto.</p><div class="finish-list">{finishes.map((finish) => <span>{finish}</span>)}</div></div></div></section>
  <section class="section"><div class="container split"><div class="reveal"><p class="eyebrow">ANODIZAÇÃO E REVESTIMENTOS</p><h2>Acabamentos para função e estética.</h2><p>Opções de anodização confirmadas incluem preto, champagne, castanho, bronze e natural. A operação também trabalha com vernizes cataforético, poliuretano, poliéster e epóxi, além de pintura conforme a especificação do projeto.</p></div><div class="media-frame reveal"><img src="/images/amostras-anodizacao.webp" alt="Amostras reais de anodização em diferentes tonalidades" loading="lazy" /></div></div></section>
  <section class="section section-ice"><div class="container"><div class="heading-row reveal"><div><p class="eyebrow">PORTFÓLIO</p><h2>Componentes reais tratados pela Boreal.</h2></div><p>Exemplos de peças para aplicações industriais e de transporte, com diferentes geometrias e requisitos de acabamento.</p></div><div class="photo-grid"><figure class="reveal"><img src="/images/pecas-acabadas.webp" alt="Conjunto de peças com acabamento dourado" loading="lazy" /></figure><figure class="reveal"><img src="/images/componente-cromado.webp" alt="Componentes cilíndricos com acabamento cromado" loading="lazy" /></figure><figure class="reveal"><img src="/images/componente-dourado.webp" alt="Componente industrial com acabamento dourado" loading="lazy" /></figure></div></div></section>
  <CTA />
</BaseLayout>
