---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import CTA from '../components/CTA.astro';
---
<BaseLayout title="Pesquisa e Desenvolvimento | Boreal Plating" description="Ciência de superfícies, testes, desenvolvimento de processos e melhoria contínua aplicados à produção industrial." path="/ped/">
  <PageHero eyebrow="PESQUISA & DESENVOLVIMENTO" title="Engenharia aplicada ao processo produtivo." description="A Boreal transforma conhecimento técnico em melhorias de processo, acabamentos e soluções alinhadas aos requisitos de cada aplicação." image="/images/peca-dourada.webp" imageAlt="Componente industrial com acabamento dourado desenvolvido pela Boreal" />
  <section class="section"><div class="container intro-grid reveal"><div><p class="eyebrow">P&D</p><h2>Pesquisa conectada às necessidades da indústria.</h2></div><div class="intro-copy"><p>O trabalho de Pesquisa e Desenvolvimento reúne ciência e engenharia de superfícies, caracterização de materiais, análises e avaliações de desempenho. O objetivo é validar soluções e melhorar continuamente processos e produtos.</p><p>O desenvolvimento é conduzido com foco técnico, considerando requisitos de aplicação, qualidade, confiabilidade e redução de impactos.</p></div></div></section>
  <section class="section section-ice"><div class="container"><div class="rd-grid">
    <article class="rd-card reveal"><span class="mark">01</span><h3>Ciência e engenharia de superfícies</h3><p>Pesquisa de novos processos de revestimento e tecnologias para aplicações de alta exigência.</p></article>
    <article class="rd-card reveal"><span class="mark">02</span><h3>Laboratórios e confiabilidade</h3><p>Testes de desempenho, caracterização de materiais e análises de superfície para validar cada solução.</p></article>
    <article class="rd-card reveal"><span class="mark">03</span><h3>Parcerias técnicas</h3><p>Colaboração com universidades, centros de pesquisa, startups e empresas de tecnologia.</p></article>
  </div></div></section>
  <section class="section section-dark"><div class="container split"><div class="media-frame reveal"><img src="/images/componente-dourado.webp" alt="Detalhe de acabamento metálico em componente real" loading="lazy" /></div><div class="reveal"><p class="eyebrow light">RESULTADOS APLICADOS</p><h2>Pesquisa que melhora produtos e processos.</h2><div class="process-list"><article class="process-item"><h3>Ligas e substratos</h3><p>Estudos para elevar a aderência, o desempenho e o padrão estético do plating.</p></article><article class="process-item"><h3>Cores e tonalidades</h3><p>Desenvolvimento de referências visuais para aplicações com requisitos específicos.</p></article><article class="process-item"><h3>Equipamentos e processo</h3><p>Desenvolvimento e instalação de recursos que apoiam qualidade e estabilidade operacional.</p></article><article class="process-item"><h3>Tecnologias de revestimento</h3><p>Pesquisa de alternativas de alta performance e menor impacto ambiental.</p></article></div></div></div></section>
  <CTA />
</BaseLayout>
