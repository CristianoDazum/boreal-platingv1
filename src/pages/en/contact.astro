---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import ContactForm from '../../components/ContactForm.astro'; import { site } from '../../data/site';
---
<BaseLayout title="Contact | Boreal Plating" description="Contact Boreal Plating about technical requirements, surface treatment, machining and component manufacturing." lang="en" path="/en/contact/">
  <PageHero eyebrow="CONTACT" title="Let's talk about your project." description="Share the technical or commercial requirements of your application. Boreal's team can help define the next steps." image="/images/recepcao-boreal.webp" imageAlt="Entrance to Boreal Plating in Joinville" />
  <section class="section"><div class="container contact-grid"><div class="reveal"><p class="eyebrow">SALES CONTACT</p><h2>Technical information starts with a focused conversation.</h2><p>Contact us to evaluate processes, finishes, production integration and supply requirements.</p><div class="contact-list"><div class="contact-item"><span>Address</span><p>{site.address}</p></div><div class="contact-item"><span>Phone</span><a href={site.phoneHref}>{site.phone}</a></div><div class="contact-item"><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="contact-item"><span>Social</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a> · <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div></div><div class="reveal"><ContactForm lang="en" /></div></div></section>
  <iframe class="map-frame" title="Map of Boreal Plating in Joinville" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Rua%20Tuiuti%203835%20Joinville%20SC&output=embed"></iframe>
</BaseLayout>
