---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import CTA from '../../components/CTA.astro';
const processes = [['Engineering','Feasibility studies and development based on project requirements.'],['Raw material','Selection and purchasing in accordance with technical specifications.'],['Machining','Dimensionally controlled manufacturing with precision, repeatability and traceability.'],['Mechanical finishing','Surface preparation for functional and visual requirements.'],['Plating','Chemical and electrolytic treatments with controlled parameters, thickness and finish.'],['Assembly','Component integration and final checks against assembly specifications.'],['Shipment','Inspection, documentation and dispatch in accordance with customer requirements.']];
const finishes = ['14k Gold','24k Gold','Almond Gold','Antique Nickel','Bronze Dark Aged Antique','Champagne Gold','Chrome','Copper','Crescent Gold','Nickel','Platinum','Rose Gold','Silver','Smoked Nickel'];
---
<BaseLayout title="What We Do | Boreal Plating" description="Capabilities in surface treatment, plating, machining, injection molding, manufacturing, assembly and industrial finishing." lang="en" path="/en/what-we-do/">
  <PageHero eyebrow="WHAT WE DO" title="Integrated industrial capability at every stage." description="From engineering to shipment, Boreal combines manufacturing and finishing with process control, traceability and close attention to technical requirements." image="/images/processo-plating.webp" imageAlt="Metal parts manufactured and treated by Boreal" />
  <section class="section"><div class="container"><div class="heading-row reveal"><div><p class="eyebrow">SUPPLY FLOW</p><h2>A connected process from start to finish.</h2></div><p>Integrated stages reduce interfaces, keep technical criteria visible and support a consistent result.</p></div><div class="process-list">{processes.map(([title, description]) => <article class="process-item reveal"><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section section-dark"><div class="container finish-grid"><div class="media-frame reveal"><img src="/images/amostras-plating.webp" alt="Boreal's real plating color and finish samples" loading="lazy" /></div><div class="reveal"><p class="eyebrow light">PLATING</p><h2>A broad range of colors and finishes.</h2><p>Decorative finishes in polished, brushed or satin versions. Other colors and tones can be developed to meet project specifications.</p><div class="finish-list">{finishes.map((finish) => <span>{finish}</span>)}</div></div></div></section>
  <section class="section"><div class="container split"><div class="reveal"><p class="eyebrow">ANODIZING AND COATINGS</p><h2>Finishes for function and aesthetics.</h2><p>Confirmed anodizing options include black, champagne, brown, bronze and natural. The operation also works with cataphoretic, polyurethane, polyester and epoxy coatings, as well as project-specific painting.</p></div><div class="media-frame reveal"><img src="/images/amostras-anodizacao.webp" alt="Real anodizing samples in different colors" loading="lazy" /></div></div></section>
  <section class="section section-ice"><div class="container"><div class="heading-row reveal"><div><p class="eyebrow">PORTFOLIO</p><h2>Real components treated by Boreal.</h2></div><p>Examples of parts for industrial and transportation applications, with varied geometries and finishing requirements.</p></div><div class="photo-grid"><figure class="reveal"><img src="/images/pecas-acabadas.webp" alt="Set of gold-finished parts" loading="lazy" /></figure><figure class="reveal"><img src="/images/componente-cromado.webp" alt="Chrome-finished cylindrical components" loading="lazy" /></figure><figure class="reveal"><img src="/images/componente-dourado.webp" alt="Gold-finished industrial component" loading="lazy" /></figure></div></div></section><CTA lang="en" />
</BaseLayout>
