---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import DocumentGrid from '../../components/DocumentGrid.astro'; import CTA from '../../components/CTA.astro'; import { esgDocumentsEn } from '../../data/site';
---
<BaseLayout title="ESG | Boreal Plating" description="Boreal's environmental, social and governance practices, with access to policies, certificates and reports." lang="en" path="/en/esg/">
  <PageHero eyebrow="ESG" title="Responsibility integrated into the way we operate." description="The environment, people and governance are managed as parts of Boreal's industrial process and stakeholder relationships." image="/images/fachada-boreal.webp" imageAlt="Boreal's industrial operation in Joinville" />
  <section class="section"><div class="container intro-grid reveal"><div><p class="eyebrow">COMMITMENT</p><h2>Structured practices and accessible information.</h2></div><div class="intro-copy"><p>Boreal conducts its activities with a focus on impact prevention, respect for people and compliance. Policies, certificates and reports make the commitments guiding the operation publicly available.</p></div></div></section>
  <section class="section-tight section-ice"><div class="container"><div class="pillars"><article class="pillar reveal"><b>01 · ENVIRONMENTAL</b><h3>Environmental and energy management</h3><p>Guidelines for pollution prevention, responsible resource use, emissions management and renewable-energy consumption.</p></article><article class="pillar reveal"><b>02 · SOCIAL</b><h3>Respect and transparency</h3><p>Commitments to ethical conduct, responsible relationships and publication of pay-equity reports.</p></article><article class="pillar reveal"><b>03 · GOVERNANCE</b><h3>Compliance and security</h3><p>Integrity principles, corporate controls and ongoing development of information-security practices.</p></article></div></div></section>
  <section class="section"><div class="container"><div class="heading-row reveal"><div><p class="eyebrow">DOCUMENTS AND REPORTS</p><h2>Documented commitments.</h2></div><p>Files open in a new tab and can also be downloaded for reference.</p></div><DocumentGrid documents={esgDocumentsEn} lang="en" /></div></section><CTA lang="en" />
</BaseLayout>
