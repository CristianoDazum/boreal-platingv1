---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import CTA from '../../components/CTA.astro';
---
<BaseLayout title="Research and Development | Boreal Plating" description="Surface science, testing, process development and continual improvement applied to industrial production." lang="en" path="/en/r-and-d/">
  <PageHero eyebrow="RESEARCH & DEVELOPMENT" title="Engineering applied to production." description="Boreal turns technical knowledge into process improvements, finishes and solutions aligned with the requirements of each application." image="/images/peca-dourada.webp" imageAlt="Gold-finished industrial component developed by Boreal" />
  <section class="section"><div class="container intro-grid reveal"><div><p class="eyebrow">R&D</p><h2>Research connected to industrial needs.</h2></div><div class="intro-copy"><p>Research and Development combines surface science and engineering, material characterization, analysis and performance evaluation. The goal is to validate solutions and continually improve processes and products.</p><p>Development is technically driven and considers application, quality, reliability and impact-reduction requirements.</p></div></div></section>
  <section class="section section-ice"><div class="container"><div class="rd-grid"><article class="rd-card reveal"><span class="mark">01</span><h3>Surface science and engineering</h3><p>Research into new coating processes and technologies for demanding applications.</p></article><article class="rd-card reveal"><span class="mark">02</span><h3>Laboratories and reliability</h3><p>Performance tests, material characterization and surface analysis to validate solutions.</p></article><article class="rd-card reveal"><span class="mark">03</span><h3>Technical partnerships</h3><p>Collaboration with universities, research centers, startups and technology companies.</p></article></div></div></section>
  <section class="section section-dark"><div class="container split"><div class="media-frame reveal"><img src="/images/componente-dourado.webp" alt="Close-up of a real metallic finish" loading="lazy" /></div><div class="reveal"><p class="eyebrow light">APPLIED RESULTS</p><h2>Research that improves products and processes.</h2><div class="process-list"><article class="process-item"><h3>Alloys and substrates</h3><p>Studies to improve plating adhesion, performance and aesthetic standards.</p></article><article class="process-item"><h3>Colors and tones</h3><p>Development of visual references for applications with specific requirements.</p></article><article class="process-item"><h3>Equipment and process</h3><p>Development and installation of resources that support quality and operational stability.</p></article><article class="process-item"><h3>Coating technologies</h3><p>Research into high-performance alternatives with lower environmental impact.</p></article></div></div></div></section><CTA lang="en" />
</BaseLayout>
